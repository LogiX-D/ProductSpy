# Copy to ignored .env.production and supply actual values outside Git.
PRODUCTSPY_MODE=saas
PRODUCTSPY_ENV=production
PRODUCTSPY_APP_URL=https://productspy.example.com
DATABASE_URL=postgresql://productspy_app:REPLACE_PASSWORD@db:5432/productspy
PRODUCTSPY_AUTO_MIGRATE=0
PRODUCTSPY_JOB_RUNNER=external
# Optional comma-separated verified Chrome Web Store IDs. Default: fixed SaaS preview ID.
# PRODUCTSPY_EXTENSION_IDS=jhbdenjnkollamkdlombhjdhldciabpg
# Per process limits. Small-host staging candidates: pool 3 / worker 1, subject to measurement.
PRODUCTSPY_DB_POOL_MAX=12
PRODUCTSPY_WORKER_CONCURRENCY=2
PRODUCTSPY_ARCHIVE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AI_MODE=real
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional provider-specific field; omit leaves the request unchanged.
AI_THINKING=omit
# Per user / UTC day. This is not a global monetary budget or an API-key spending cap.
AI_DAILY_REQUEST_LIMIT=50
# Sandbox only until live billing is separately authorized.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
PRODUCTSPY_ENABLE_LIVE_BILLING=0
