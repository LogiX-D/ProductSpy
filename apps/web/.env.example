# SaaS 源码开发；正式环境用根 .env.production.example 注入服务器配置。
# pnpm dev 会自动配置本机 PGlite。手工运行时二选一：
# DATABASE_URL=postgresql://productspy_app:YOUR_PASSWORD@127.0.0.1:5432/productspy
# PRODUCTSPY_DB_DRIVER=pglite
# PRODUCTSPY_PGLITE_DIR=你的私人开发数据目录
PRODUCTSPY_MODE=saas
PRODUCTSPY_ENV=development
PRODUCTSPY_APP_URL=http://127.0.0.1:3000
# production 使用 external 并运行 pnpm worker；开发可使用 inline。
PRODUCTSPY_JOB_RUNNER=inline
# 历史清理需设置至少32字符随机服务端secret；不设置仍可查看/导出。
PRODUCTSPY_ARCHIVE_SECRET=
# 不设置 AI_API_KEY 时默认使用 Mock。设置后重启 Web。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# auto | mock | real；real 在缺少 Key 时返回明确错误
AI_MODE=auto
# 显式兼容选项。不支持参数时人工切换，程序不自动重发付费请求。
# json_object | json_schema | text；text 仍必须返回可校验的 JSON。
AI_RESPONSE_FORMAT=json_object
# 新版 OpenAI / reasoning 模型可选 max_completion_tokens。
AI_TOKEN_PARAMETER=max_tokens
AI_MAX_OUTPUT_TOKENS=8192
# 1,000–120,000 毫秒；超时不自动重试。
AI_TIMEOUT_MS=60000
# omit 表示不发送 temperature，兼容不支持自定义温度的模型。
AI_TEMPERATURE=omit
# 每天 UTC 日界线的真实请求上限，失败和中断也计入；并发上限固定 2。
AI_DAILY_REQUEST_LIMIT=50
# 可选：本地数据目录。默认 apps/web/.data
# PRODUCTSPY_DATA_DIR=
