{
  "name": "productspy",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @productspy/web dev",
    "build": "pnpm --filter @productspy/extension build && pnpm --filter @productspy/web build",
    "start": "pnpm --filter @productspy/web start",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:windows": "pnpm build && node scripts/package-windows.mjs",
    "package:extension": "pnpm --filter @productspy/extension build && node scripts/package-extension.mjs",
    "package:store": "node scripts/package-store.mjs",
    "test:portable": "node scripts/test-portable.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "capture:experience": "node scripts/capture-experience.mjs",
    "test:ai-quality": "vitest run apps/web/src/lib/ai-quality/quality.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
